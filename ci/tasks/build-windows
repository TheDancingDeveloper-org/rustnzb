#!/bin/sh
set -eu
. "$(dirname "$0")/lib.sh"
. "$(dirname "$0")/auditable"
trap cleanup_task_frontend EXIT
task_start build-windows cargo clang lld curl xz
task_target_dir build-windows
ensure_frontend
install_cargo_auditable
auditable_env
if [ -n "${CI_COMMIT_TAG:-}" ]; then
    export CARGO_PROFILE_RELEASE_LTO=fat CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 CARGO_PROFILE_RELEASE_STRIP=symbols
fi
XWIN_ACCEPT_LICENSE=1 cargo xwin build --release --target x86_64-pc-windows-msvc --features webdav --locked
binary=$CARGO_TARGET_DIR/x86_64-pc-windows-msvc/release/rustnzb.exe
test -f "$binary"
verify_auditable_binary "$binary" x86_64-pc-windows-msvc
file "$binary"
ls -lh "$binary"
show_sccache_stats
