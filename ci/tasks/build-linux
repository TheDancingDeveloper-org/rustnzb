#!/bin/sh
set -eu
. "$(dirname "$0")/lib.sh"
. "$(dirname "$0")/auditable"
trap cleanup_task_frontend EXIT
task_start build-linux cargo npm curl xz
task_target_dir build-linux
ensure_frontend
install_cargo_auditable
if [ -n "${CI_COMMIT_TAG:-}" ]; then
    export CARGO_PROFILE_RELEASE_LTO=fat CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 CARGO_PROFILE_RELEASE_STRIP=symbols
fi
auditable_cargo build --release -p rustnzb --features webdav --locked
test -x "$CARGO_TARGET_DIR/release/rustnzb"
verify_auditable_binary "$CARGO_TARGET_DIR/release/rustnzb" x86_64-unknown-linux-gnu
ls -lh "$CARGO_TARGET_DIR/release/rustnzb"
show_sccache_stats
