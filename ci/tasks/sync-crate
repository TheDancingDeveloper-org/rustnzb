#!/bin/sh
set -eu

# sync-crate <name> — carry one nzb-* crate from the monorepo head to its
# standalone repo.
#
# Exports crates/<name> at HEAD (tracked files only), replaces the standalone
# repo's tree with it, and opens a pull request against that repo's main
# branch. The monorepo owns version numbers, so the exported Cargo.toml
# carries the version across untouched. Publishing to crates.io happens from a
# tag on the standalone repo after this PR merges (see docs/RELEASING.md); this
# task never publishes and never pushes to the monorepo.
#
# Requires GH_TOKEN (a token that can push to and open PRs on the standalone
# repo) and the gh CLI.

crate=${1:?usage: sync-crate <nzb-crate-name>}

TASK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$TASK_DIR/../.." && pwd)
cd "$REPO_ROOT"

grep -qx "$crate" ci/nzb-crates.txt \
    || { echo "$crate is not a synced nzb-* crate (see ci/nzb-crates.txt)" >&2; exit 2; }

manifest="crates/$crate/Cargo.toml"
[ -f "$manifest" ] || { echo "unknown crate: no $manifest" >&2; exit 2; }

: "${GH_TOKEN:?GH_TOKEN is required}"
command -v gh >/dev/null 2>&1 || { echo "the gh CLI is required" >&2; exit 127; }

manifest_field() { grep -m1 "^$2[[:space:]]*=" "$1" | sed 's/[^"]*"\([^"]*\)".*/\1/'; }

repo=$(manifest_field "$manifest" repository)
version=$(manifest_field "$manifest" version)
[ -n "$repo" ] || { echo "$crate has no repository field" >&2; exit 2; }
slug=$(printf '%s' "$repo" | sed 's#https://github.com/##; s#\.git$##')
head_sha=$(git rev-parse --short HEAD)
branch="sync/monorepo-$head_sha"

workdir=$(mktemp -d)
askpass=$(mktemp)
cleanup() { rm -rf "$workdir"; rm -f "$askpass"; }
trap cleanup EXIT

cat >"$askpass" <<'ASK'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\n' x-access-token ;;
    *Password*) printf '%s\n' "$GH_TOKEN" ;;
    *) exit 1 ;;
esac
ASK
chmod 700 "$askpass"
export GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 GH_TOKEN

clone="$workdir/repo"
git clone --quiet "$repo" "$clone"
git -C "$clone" checkout -q -B "$branch"

# Refuse while the standalone repo still carries commits of its own, made since
# the last sync, whose non-preserved changes the monorepo has not absorbed. A
# sync replaces the standalone tree, so pushing one over unported work would
# drop it. The last sync commit is the newest "sync: <crate> from rustnzb
# monorepo" commit; commits before it were already reconciled. Standalone-only
# paths (ci/sync-preserve.txt) are infrastructure and do not count. A path that
# the monorepo now exports byte-for-byte has been absorbed, so a commit whose
# every non-preserved path matches the export is no longer unported.
preserve="$REPO_ROOT/ci/sync-preserve.txt"
export_tree="$workdir/export"
mkdir -p "$export_tree"
git archive "HEAD:crates/$crate" | tar -x -C "$export_tree"
find "$export_tree" -name Cargo.toml -print0 | xargs -0 \
    sed -i "s#^\\($crate\\)[[:space:]]*=[[:space:]]*{[[:space:]]*workspace[[:space:]]*=[[:space:]]*true[[:space:]]*}#\\1 = { path = \"..\" }#"
preserved_path() {
    path=$1
    [ -f "$preserve" ] || return 1
    while IFS= read -r rule; do
        case "$rule" in ''|\#*) continue ;; esac
        case "$path" in "$rule"|"$rule"/*) return 0 ;; esac
    done <"$preserve"
    return 1
}
last_sync=$(git -C "$clone" log --format='%H' --grep="^sync: $crate from rustnzb monorepo" -n 1 main || true)
range=main
[ -n "$last_sync" ] && range="$last_sync..main"
unported=$(git -C "$clone" log --format='%h %s' "$range" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    sha=${line%% *}
    touched=0
    for path in $(git -C "$clone" diff-tree --no-commit-id --name-only -r "$sha"); do
        preserved_path "$path" && continue
        mono="$export_tree/$path"
        stand="$clone/$path"
        if [ -f "$mono" ] && [ -f "$stand" ] && cmp -s "$mono" "$stand"; then
            continue
        fi
        touched=1
    done
    [ "$touched" -eq 1 ] && printf '%s\n' "$line" || true
done)
if [ -n "$unported" ]; then
    echo "sync-crate: refusing to sync $crate — commits since the last sync touch paths the monorepo does not own yet:" >&2
    printf '%s\n' "$unported" | sed 's/^/    /' >&2
    echo "sync-crate: port them into the monorepo first, then re-run." >&2
    exit 3
fi

# Replace the standalone tree with the monorepo crate at HEAD. Clear the old
# tracked files first so deletions in the monorepo propagate, then extract the
# crate subtree (git archive emits tracked files only, no target/).
#
# Paths listed in ci/sync-preserve.txt survive the replace, so a sync never
# deletes them. A path the monorepo starts shipping is no longer preserved.
# Newline-delimited (POSIX sh has no `read -d`); quotePath=false keeps
# non-ASCII names literal rather than C-quoted.
git -C "$clone" -c core.quotePath=false ls-files | while IFS= read -r path; do
    if preserved_path "$path" && [ ! -e "$export_tree/$path" ]; then
        continue
    fi
    rm -f "$clone/$path"
done
tar -c -C "$export_tree" . | tar -x -C "$clone"

git -C "$clone" add -A
if git -C "$clone" diff --cached --quiet; then
    echo "sync-crate: $crate already matches the standalone repo at v$version; nothing to do"
    exit 0
fi

git -C "$clone" commit -q \
    -m "sync: $crate from rustnzb monorepo $head_sha (v$version)"
git -C "$clone" push -q --force-with-lease -u origin "$branch"

gh pr create --repo "$slug" --head "$branch" --base main \
    --title "sync: $crate from rustnzb monorepo $head_sha" \
    --body "Automated sync of \`crates/$crate\` at rustnzb monorepo commit $head_sha (version $version).

The monorepo owns nzb-* version numbers; this PR carries its current tree across verbatim. After merge, publish v$version from a \`v$version\` tag on this repo — see rustnzb docs/RELEASING.md."

echo "sync-crate: opened a PR on $slug from branch $branch (v$version)"
