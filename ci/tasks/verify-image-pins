#!/bin/sh
# Offline gate for the CI image pins: needs only sh, awk, sed and grep, so it
# deliberately skips task_start (which would probe rustc/cargo and can trigger
# a rustup toolchain install).
set -eu
. "$(dirname "$0")/lib.sh"
cd "$REPO_ROOT"
printf 'task=%s\n' verify-image-pins
for tool in awk sed grep; do
    command -v "$tool" >/dev/null 2>&1 || {
        printf 'required tool is missing: %s\n' "$tool" >&2
        exit 127
    }
done

lock=$REPO_ROOT/ci/images.lock
test -f "$lock"

lock_value() {
    sed -n "s/^$1=//p" "$lock"
}

# (1) every image in the lock is pinned by a 64-hex sha256 digest.
for key in CORE_IMAGE CROSS_IMAGE E2E_IMAGE DESKTOP_IMAGE; do
    value=$(lock_value "$key")
    case "$value" in
        *@sha256:????????????????????????????????????????????????????????????????) ;;
        *) printf '%s is not pinned by sha256 digest: %s\n' "$key" "$value" >&2; exit 1 ;;
    esac
    digest=${value##*@sha256:}
    case "$digest" in
        *[!0-9a-f]*) printf '%s digest is not 64 lowercase hex: %s\n' "$key" "$value" >&2; exit 1 ;;
    esac
done

# (2) the digests consumed on GitHub match the lock.
cross=$(lock_value CROSS_IMAGE)
dockerfile_cross=$(sed -n 's/^ARG CROSS_IMAGE=//p' "$REPO_ROOT/Dockerfile")
[ "$dockerfile_cross" = "$cross" ] || {
    printf 'Dockerfile CROSS_IMAGE drifted from ci/images.lock: %s != %s\n' \
        "$dockerfile_cross" "$cross" >&2
    exit 1
}
promote=$REPO_ROOT/.github/workflows/promote-release.yml
promote_cross=$(sed -n 's/^[[:space:]]*CROSS_IMAGE:[[:space:]]*//p' "$promote")
[ "$promote_cross" = "$cross" ] || {
    printf '.github/workflows/promote-release.yml CROSS_IMAGE drifted from ci/images.lock: %s != %s\n' \
        "$promote_cross" "$cross" >&2
    exit 1
}

# The cross image is pinned only in the lock, never by a repo variable.
if grep -Fq 'RUSTNZB_CROSS_IMAGE' "$REPO_ROOT"/.github/workflows/*.yml; then
    printf '.github/workflows references RUSTNZB_CROSS_IMAGE; read CROSS_IMAGE from ci/images.lock\n' >&2
    exit 1
fi

# (3) ci/run still reads the lock.
for needle in ci/images.lock CORE_IMAGE CROSS_IMAGE E2E_IMAGE DESKTOP_IMAGE; do
    grep -Fq "$needle" "$REPO_ROOT/ci/run" || {
        printf 'ci/run no longer mentions %s\n' "$needle" >&2
        exit 1
    }
done

# (4) no mutable image references in the workflows.
if grep -Eq 'image: [^[:space:]]+:(latest|[0-9]+\.[0-9]+(-[^@[:space:]]*)?)[[:space:]]*$' \
    "$REPO_ROOT"/.github/workflows/*.yml; then
    printf '.github/workflows contains a mutable image reference\n' >&2
    exit 1
fi

printf 'image pins are valid\n'
